{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": ["publint", "@arethetypeswrong/cli"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "e2e/**/*.spec.ts", "tsup.preset.ts", "e2e/*.mjs", "e2e/fixtures/*.tsx"],
      "project": ["scripts/**", "e2e/**", "*.ts"]
    },
    "packages/*": {
      "entry": ["src/index.ts", "__tests__/**/*.{test,test-d}.{ts,tsx}"],
      "project": ["src/**", "__tests__/**"]
    },
    "packages/adapter-drizzle": {
      "entry": ["__tests__/**/*.{test,test-d}.{ts,tsx}"],
      "project": ["src/**", "__tests__/**"]
    },
    "packages/adapter-kit": {
      "entry": ["__tests__/**/*.{test,test-d}.{ts,tsx}"],
      "project": ["src/**", "__tests__/**"]
    },
    "packages/cli": {
      "entry": ["__tests__/**/*.{test,test-d}.{ts,tsx}"],
      "project": ["src/**", "__tests__/**"]
    },
    "packages/core": {
      "entry": ["__tests__/**/*.{test,test-d}.{ts,tsx}"],
      "project": ["src/**", "__tests__/**"]
    },
    "packages/integration-issues": {
      "entry": ["__tests__/**/*.{test,test-d}.{ts,tsx}"],
      "project": ["src/**", "__tests__/**"]
    },
    "packages/screenshot-storage": {
      "entry": ["__tests__/**/*.{test,test-d}.{ts,tsx}"],
      "project": ["src/**", "__tests__/**"]
    },
    "packages/widget": {
      "entry": ["__tests__/**/*.{test,test-d}.{ts,tsx}"],
      "project": ["src/**", "__tests__/**"]
    },
    "apps/demo": {}
  }
}
