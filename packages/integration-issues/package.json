{
  "name": "@siteping/integration-issues",
  "version": "0.0.0",
  "description": "Issue tracker integration for Siteping — one issue per feedback on GitHub, GitLab or your own tracker, kept in sync through @siteping/server lifecycle hooks",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./github": {
      "import": {
        "types": "./dist/github.d.ts",
        "default": "./dist/github.js"
      },
      "require": {
        "types": "./dist/github.d.cts",
        "default": "./dist/github.cjs"
      }
    },
    "./gitlab": {
      "import": {
        "types": "./dist/gitlab.d.ts",
        "default": "./dist/gitlab.js"
      },
      "require": {
        "types": "./dist/gitlab.d.cts",
        "default": "./dist/gitlab.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/fix-dts.mjs dist",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "siteping",
    "issues",
    "github",
    "gitlab",
    "integration",
    "feedback",
    "typescript"
  ],
  "author": "neosianexus",
  "license": "MIT",
  "homepage": "https://siteping.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NeosiaNexus/SitePing.git",
    "directory": "packages/integration-issues"
  },
  "bugs": {
    "url": "https://github.com/NeosiaNexus/SitePing/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@siteping/adapter-memory": "workspace:*",
    "@siteping/core": "workspace:*",
    "@siteping/server": "workspace:*",
    "mdast-util-from-markdown": "^2.0.3"
  },
  "peerDependencies": {
    "@siteping/server": "workspace:^"
  }
}
