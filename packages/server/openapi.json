            "format": "date-time"
          },
          "annotations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Annotation"
            }
          },
          "comments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Comment"
            }
          },
          "screenshotUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "screenshotRegion": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ScreenshotRegion"
              },
              {
                "type": "null"
              }
            ]
          },
          "diagnostics": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Diagnostics"
              },
              {
                "type": "null"
              }
            ]
          },
          "permissions": {
            "$ref": "#/components/schemas/FeedbackPermissions"
          }
