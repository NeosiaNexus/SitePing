{
  "openapi": "3.1.0",
  "info": {
    "title": "SitePing HTTP API",
    "version": "1",
    "description": "The protocol `createSitepingHandler` (`@siteping/server`) serves: one endpoint, mounted at any path (`/api/siteping` here, what `npx @siteping/cli init` generates), five methods, JSON bodies. `info.version` is the protocol version a list response sends as `protocol`. Error strings are informational: branch on the status code. See https://siteping.dev/docs/server#wire-protocol.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    }
  },
  "x-siteping-protocol": 1,
  "paths": {
    "/api/siteping": {
      "get": {
        "operationId": "listFeedbacks",
        "summary": "List a project's feedbacks",
        "description": "A page of feedbacks, newest first, each with its thread and the requester's permissions. Author emails are blanked unless the access policy lets the requester read them; `clientId` is never sent.",
        "parameters": [
          {
            "name": "projectName",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "default": 1,
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "default": 50,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "question",
                "change",
                "bug",
                "other"
              ]
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "open",
                "in_progress",
                "resolved",
                "wont_fix"
              ]
            }
          },
          {
            "name": "statuses",
            "in": "query",
            "required": false,
            "schema": {
              "maxItems": 4,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "open",
                  "in_progress",
                  "resolved",
                  "wont_fix"
                ]
              }
            },
            "style": "form",
            "explode": false,
            "description": "Statuses to include, comma-separated; takes precedence over `status`."
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 2000
            }
          },
          {
            "name": "urlPattern",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 2000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The page.",
            "headers": {
              "Cache-Control": {
                "description": "`private, max-age=5` under the `apiKey` policy, `no-store` under `access`.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedbackList"
                }
              }
            }
          },
          "400": {
            "description": "A query parameter failed validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrors"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "post": {
        "operationId": "createFeedbackOrComment",
        "summary": "Create a feedback, or a comment on one",
        "description": "Routed by the body: one carrying `feedbackId` posts a comment to that feedback's thread, any other creates a feedback. Both are idempotent on `clientId`: a replay answers `201` with the stored record.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/FeedbackCreate",
                    "not": {
                      "required": [
                        "feedbackId"
                      ]
                    }
                  },
                  {
                    "$ref": "#/components/schemas/CommentCreate"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The feedback (fresh or replayed), or the comment.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Feedback"
                    },
                    {
                      "$ref": "#/components/schemas/Comment"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "Comment: the feedback does not exist in this project.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Feedback: its `clientId` is already used by another project. Comment: the thread holds 100 `client` comments, or the comment's `clientId` is already used on another feedback. None is worth a retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "422": {
            "$ref": "#/components/responses/ValueTooLong"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          },
          "501": {
            "description": "Comment: the store behind the endpoint keeps no comments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateFeedbackStatus",
        "summary": "Change a feedback's status",
        "description": "`resolvedAt` follows: set when the status becomes `resolved` or `wont_fix`, cleared otherwise.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeedbackPatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated feedback.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Feedback"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "The feedback does not exist in this project.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "delete": {
        "operationId": "deleteFeedbackOrComment",
        "summary": "Delete a feedback, every feedback of a project, or a comment",
        "description": "Routed by the body: one carrying `commentId` deletes that comment from the feedback's thread, any other deletes feedback. The body is required: a proxy that strips `DELETE` bodies makes it a `400`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/FeedbackDelete",
                    "not": {
                      "required": [
                        "commentId"
                      ]
                    }
                  },
                  {
                    "$ref": "#/components/schemas/FeedbackDeleteAll",
                    "not": {
                      "required": [
                        "commentId"
                      ]
                    }
                  },
                  {
                    "$ref": "#/components/schemas/CommentDelete"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Deleted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Deleted"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "The feedback, or the comment, does not exist in this project.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          },
          "501": {
            "description": "Comment: the store behind the endpoint keeps no comments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "An `onDeleting` hook threw: nothing was deleted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "options": {
        "operationId": "preflight",
        "summary": "CORS preflight",
        "security": [],
        "responses": {
          "204": {
            "description": "CORS headers for an origin listed in `allowedOrigins`; none otherwise, and the browser blocks the request."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FeedbackCreate": {
        "type": "object",
        "properties": {
          "projectName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "type": {
            "type": "string",
            "enum": [
              "question",
              "change",
              "bug",
              "other"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "urlPattern": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ]
          },
          "viewport": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "userAgent": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "authorName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "authorEmail": {
            "type": "string",
            "maxLength": 200,
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)[\\p{L}\\p{M}\\p{N}!#$%&'*+/=?^_`{|}~.-]{0,63}[\\p{L}\\p{M}\\p{N}!#$%&'*+/=?^_`{|}~-]@(?:[\\p{L}\\p{N}](?:[\\p{L}\\p{M}\\p{N}-]{0,61}[\\p{L}\\p{M}\\p{N}])?\\.)+[\\p{L}\\p{N}][\\p{L}\\p{M}\\p{N}-]{0,61}[\\p{L}\\p{M}\\p{N}]$"
          },
          "annotations": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "anchor": {
                  "type": "object",
                  "properties": {
                    "cssSelector": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "xpath": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "textSnippet": {
                      "type": "string",
                      "maxLength": 500
                    },
                    "elementTag": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 191
                    },
                    "elementId": {
                      "type": "string"
                    },
                    "textPrefix": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "textSuffix": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "fingerprint": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "neighborText": {
                      "type": "string",
                      "maxLength": 500
                    },
                    "anchorKey": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 200
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "cssSelector",
                    "xpath",
                    "textSnippet",
                    "elementTag",
                    "textPrefix",
                    "textSuffix",
                    "fingerprint",
                    "neighborText"
                  ]
                },
                "rect": {
                  "type": "object",
                  "properties": {
                    "xPct": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "yPct": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "wPct": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "hPct": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "xPct",
                    "yPct",
                    "wPct",
                    "hPct"
                  ]
                },
                "scrollX": {
                  "type": "number"
                },
                "scrollY": {
                  "type": "number"
                },
                "viewportW": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 2147483647
                },
                "viewportH": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 2147483647
                },
                "devicePixelRatio": {
                  "default": 1,
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "anchor",
                "rect",
                "scrollX",
                "scrollY",
                "viewportW",
                "viewportH"
              ]
            }
          },
          "clientId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "screenshotDataUrl": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1500000,
                "pattern": "^data:image\\/(jpeg|png|webp);base64,"
              },
              {
                "type": "null"
              }
            ]
          },
          "screenshotRegion": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ScreenshotRegion"
              },
              {
                "type": "null"
              }
            ]
          },
          "diagnostics": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "console": {
                    "maxItems": 50,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "level": {
                          "type": "string",
                          "enum": [
                            "log",
                            "info",
                            "warn",
                            "error"
                          ]
                        },
                        "timestamp": {
                          "type": "string",
                          "maxLength": 50
                        },
                        "message": {
                          "type": "string",
                          "maxLength": 600
                        }
                      },
                      "required": [
                        "level",
                        "timestamp",
                        "message"
                      ]
                    }
                  },
                  "network": {
                    "maxItems": 20,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "url": {
                          "type": "string",
                          "maxLength": 2000
                        },
                        "method": {
                          "type": "string",
                          "maxLength": 20
                        },
                        "status": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 599
                        },
                        "durationMs": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 600000
                        },
                        "timestamp": {
                          "type": "string",
                          "maxLength": 50
                        }
                      },
                      "required": [
                        "url",
                        "method",
                        "status",
                        "durationMs",
                        "timestamp"
                      ]
                    }
                  }
                },
                "required": [
                  "console",
                  "network"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "projectName",
          "type",
          "message",
          "url",
          "viewport",
          "userAgent",
          "authorName",
          "authorEmail",
          "annotations",
          "clientId"
        ]
