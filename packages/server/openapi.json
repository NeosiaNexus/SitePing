            ]
          },
          "message": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "in_progress",
              "resolved",
              "wont_fix"
            ]
          },
          "projectName": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "urlPattern": {
            "type": [
