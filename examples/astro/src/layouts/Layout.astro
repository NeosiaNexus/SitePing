---
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <nav>
      <a href="/">Home</a>
      <a href="/about">About</a>
    </nav>
    <main>
      <slot />
    </main>
    <script>
      // Astro bundles this as a browser module: it never runs on the server.
      import { initSiteping } from "@siteping/widget";

      // <ClientRouter /> swaps the whole <body> on navigation, the widget with
      // it: mount it on every page load and release it before every swap.
      let siteping: ReturnType<typeof initSiteping> | undefined;
      document.addEventListener("astro:page-load", () => {
        // forceShow: also show it on `npm run preview`, a production build.
        siteping = initSiteping({ endpoint: "/api/siteping", projectName: "astro-example", forceShow: true });
      });
      document.addEventListener("astro:before-swap", () => siteping?.destroy());
    </script>
  </body>
</html>

<style is:global>
  body {
    font-family: system-ui, sans-serif;
    margin: 0;
  }
  nav {
    display: flex;
    gap: 1rem;
    padding: 1rem 2rem;
    border-bottom: 1px solid #e5e7eb;
  }
  main {
    max-width: 40rem;
    padding: 2rem;
  }
</style>
