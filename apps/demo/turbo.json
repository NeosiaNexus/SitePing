{
  "$schema": "https://turborepo.dev/schema.v2.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "src/**",
        "content/**",
        "source.config.ts",
        "next.config.ts",
        "postcss.config.mjs",
        "package.json",
        "tsconfig.json"
      ],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "check": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "content/**", "source.config.ts", "package.json", "tsconfig.json"],
      "outputs": []
    }
  }
}
