# Database URL for Prisma (required for the demo with real database)
# DATABASE_URL="postgresql://user:password@localhost:5432/siteping"

# The demo runs with an in-memory store by default — no database required.
# To use a real database, uncomment DATABASE_URL and configure Prisma.

# Rybbit site id of the deployed site (audience measurement, self-hosted).
# Inlined at build time. Leave it empty or unset and no script is loaded.
# NEXT_PUBLIC_RYBBIT_SITE_ID=""
