{
  "name": "siteping",
  "private": true,
  "description": "Client feedback widget \u2014 self-hosted, DOM-anchored annotations for websites",
  "homepage": "https://siteping.dev",
  "type": "module",
  "author": "neosianexus",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NeosiaNexus/SitePing.git"
  },
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check //#check:root",
    "check:root": "tsc --noEmit",
    "clean": "turbo run clean",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "verify": "bun run build && bun run api:check && bun run check && bun run lint && bun run test:run",
    "pkg-checks": "node scripts/pkg-checks.mjs",
    "api:check": "node scripts/api-surface.mjs",
    "api:update": "node scripts/api-surface.mjs --update",
    "check:consistency": "node scripts/check-consistency.mjs",
    "knip": "knip",
    "new:locale": "node scripts/new-locale.mjs",
    "new:adapter": "node scripts/new-adapter.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.64.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-istanbul": "^5.0.5",
    "fast-check": "^4.10.2",
    "jsdom": "30.1.2",
    "knip": "^6.41.0",
    "publint": "0.3.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "terser": "^5.51.2",
    "tsup": "^8.5.1",
    "turbo": "^2.11.8",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "minimatch": "^10.2.5",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.27",
    "sharp": "^0.35.4"
  }
}
