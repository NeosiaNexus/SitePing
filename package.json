{
  "name": "siteping",
  "private": true,
  "description": "Client feedback widget \u2014 self-hosted, DOM-anchored annotations for websites",
  "homepage": "https://siteping.dev",
  "type": "module",
  "author": "neosianexus",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NeosiaNexus/SitePing.git"
  },
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check //#check:root",
    "check:root": "tsc --noEmit",
    "clean": "turbo run clean",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "verify": "bun run build && bun run check && bun run lint && bun run test:run",
    "pkg-checks": "node scripts/pkg-checks.mjs",
    "check:consistency": "node scripts/check-consistency.mjs",
    "knip": "knip",
    "new:locale": "node scripts/new-locale.mjs",
    "new:adapter": "node scripts/new-adapter.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.1",
    "@vitest/coverage-istanbul": "^5.0.1",
    "fast-check": "^4.10.1",
    "jsdom": "30.1.0",
    "knip": "^6.36.0",
    "publint": "0.3.24",
    "tsup": "^8.5.1",
    "turbo": "^2.10.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "minimatch": "^10.2.5",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.18",
    "sharp": "^0.35.0"
  }
}
