{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": true,
  "bump-patch-for-minor-pre-major": true,
  "initial-version": "0.1.0",
  "changelog-notes-type": "github",
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "refactor", "section": "Refactoring" },
    { "type": "test", "section": "Tests" },
    { "type": "docs", "section": "Documentation" },
    { "type": "chore", "section": "Miscellaneous" }
  ],
  "packages": {
    "packages/widget": {
      "release-type": "node",
      "component": "widget",
      "bump-minor-pre-major": true
    },
    "packages/adapter-prisma": {
      "release-type": "node",
      "component": "adapter-prisma",
      "bump-minor-pre-major": true
    },
    "packages/adapter-memory": {
      "release-type": "node",
      "component": "adapter-memory",
      "bump-minor-pre-major": true
    },
    "packages/adapter-localstorage": {
      "release-type": "node",
      "component": "adapter-localstorage",
      "bump-minor-pre-major": true
    },
    "packages/adapter-kit": {
      "release-type": "node",
      "component": "adapter-kit",
      "bump-minor-pre-major": true
    },
    "packages/dashboard": {
      "release-type": "node",
      "component": "dashboard",
      "bump-minor-pre-major": true
    },
    "packages/cli": {
      "release-type": "node",
      "component": "cli",
      "bump-minor-pre-major": true,
      "extra-files": ["src/index.ts"]
    },
    "packages/adapter-drizzle": {
      "release-type": "node",
      "component": "adapter-drizzle",
      "bump-minor-pre-major": true
    },
    "packages/server": {
      "release-type": "node",
      "component": "server",
      "bump-minor-pre-major": true
    },
    "packages/screenshot-storage": {
      "release-type": "node",
      "component": "screenshot-storage",
      "bump-minor-pre-major": true
    },
    "packages/integration-issues": {
      "release-type": "node",
      "component": "integration-issues",
      "bump-minor-pre-major": true
    }
  }
}
